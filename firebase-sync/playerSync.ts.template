/**
 * FIRESTORE PLAYER DATA SYNC & LOCAL STORAGE FALLBACK ENGINE
 * 
 * Provides robust sync between local localStorage state and Firestore cloud storage.
 * All functions fail-safe silently to local storage so offline play and guests never
 * white-screen or experience UI hangs.
 */

import { doc, getDoc, setDoc, onSnapshot, increment } from "firebase/firestore";
import { db } from "./firebaseClient";
import { MugenPlayerDoc, createDefaultPlayerDoc } from "./playerSchema";

// Debounce timer map per user
const saveDebounceTimers: Record<string, NodeJS.Timeout> = {};

/**
 * Load player document from Firestore with fallback to default structure
 */
export async function loadPlayer(uid: string): Promise<MugenPlayerDoc> {
  if (!db) return createDefaultPlayerDoc(uid);

  try {
    const userDocRef = doc(db, "users", uid);
    const snap = await getDoc(userDocRef);

    if (snap.exists()) {
      return snap.data() as MugenPlayerDoc;
    } else {
      const defaultDoc = createDefaultPlayerDoc(uid);
      await setDoc(userDocRef, defaultDoc, { merge: true });
      return defaultDoc;
    }
  } catch (err) {
    console.warn("[PlayerSync] Failed to load player from Firestore, utilizing local fallback:", err);
    return createDefaultPlayerDoc(uid);
  }
}

/**
 * Debounced save player data to Firestore (2-second interval)
 */
export function savePlayer(uid: string, partialData: Partial<MugenPlayerDoc>): void {
  if (!db) return;

  if (saveDebounceTimers[uid]) {
    clearTimeout(saveDebounceTimers[uid]);
  }

  saveDebounceTimers[uid] = setTimeout(async () => {
    try {
      const userDocRef = doc(db, "users", uid);
      await setDoc(
        userDocRef,
        {
          ...partialData,
          updatedAt: Date.now(),
        },
        { merge: true }
      );
      console.log(`[PlayerSync] Successfully synced partial updates to Firestore for ${uid}`);
    } catch (err) {
      console.warn("[PlayerSync] Error saving player data to Firestore:", err);
    }
  }, 2000);
}

/**
 * Subscribe to real-time updates for player's Firestore document
 */
export function subscribeToPlayer(uid: string, onUpdate: (data: MugenPlayerDoc) => void): () => void {
  if (!db) return () => {};

  try {
    const userDocRef = doc(db, "users", uid);
    const unsubscribe = onSnapshot(
      userDocRef,
      (snap) => {
        if (snap.exists()) {
          onUpdate(snap.data() as MugenPlayerDoc);
        }
      },
      (err) => {
        console.warn("[PlayerSync] Snapshot subscription error:", err);
      }
    );
    return unsubscribe;
  } catch (err) {
    console.warn("[PlayerSync] Failed to subscribe to player updates:", err);
    return () => {};
  }
}

/**
 * Atomic currency increment helper for anti-cheat and race-condition prevention
 */
export async function addGems(uid: string, deltaGems: number): Promise<void> {
  if (!db || deltaGems <= 0) return;
  try {
    const userDocRef = doc(db, "users", uid);
    await setDoc(
      userDocRef,
      {
        wallet: {
          gems: increment(deltaGems),
        },
        updatedAt: Date.now(),
      },
      { merge: true }
    );
  } catch (err) {
    console.warn("[PlayerSync] Atomic gem increment error:", err);
  }
}

/**
 * Migrates local storage data into user's Firestore cloud document upon first sign-in
 */
export async function migrateLocalToCloud(uid: string): Promise<void> {
  if (!db || typeof window === "undefined" || !window.localStorage) return;

  try {
    const userDocRef = doc(db, "users", uid);
    const snap = await getDoc(userDocRef);
    const existingDoc = snap.exists() ? (snap.data() as MugenPlayerDoc) : createDefaultPlayerDoc(uid);

    // Read local storage keys
    const rawUser = localStorage.getItem("dice_chess_user");
    const localUser = rawUser ? JSON.parse(rawUser) : null;

    const rawGems = localStorage.getItem(`mugen_gems_${uid}`);
    const localGems = rawGems ? parseInt(rawGems, 10) : 0;

    const rawKeys = localStorage.getItem(`mugen_keys_${uid}`);
    const localKeys = rawKeys ? parseInt(rawKeys, 10) : 0;

    const rawTickets = localStorage.getItem(`mugen_pass_tickets_${uid}`);
    const localTickets = rawTickets ? parseInt(rawTickets, 10) : 0;

    const rawJourney = localStorage.getItem(`mugen_journey_v1_${uid}`);
    const localJourney = rawJourney ? JSON.parse(rawJourney) : null;

    const rawKata = localStorage.getItem(`mugen_kata_progress_v2_${uid}`);
    const localKata = rawKata ? JSON.parse(rawKata) : null;

    const rawCulling = localStorage.getItem("culling_opening_completed_ids");
    const localCullingIds = rawCulling ? JSON.parse(rawCulling) : [];

    const rawChests = localStorage.getItem(`mugen_chests_inventory_v1_${uid}`);
    const localChests = rawChests ? JSON.parse(rawChests) : null;

    // Highest-wins merge for stats and currencies
    const mergedDoc: MugenPlayerDoc = {
      ...existingDoc,
      growth: {
        ...existingDoc.growth,
        wins: Math.max(existingDoc.growth.wins, localUser?.stats?.wins || 0),
        losses: Math.max(existingDoc.growth.losses, localUser?.stats?.losses || 0),
        draws: Math.max(existingDoc.growth.draws, localUser?.stats?.draws || 0),
        totalGames: Math.max(existingDoc.growth.totalGames, localUser?.stats?.totalGames || 0),
      },
      wallet: {
        ...existingDoc.wallet,
        gems: Math.max(existingDoc.wallet.gems, localGems),
        keys: Math.max(existingDoc.wallet.keys, localKeys),
        passTickets: Math.max(existingDoc.wallet.passTickets, localTickets),
      },
      modes: {
        ...existingDoc.modes,
        journey: {
          ...existingDoc.modes.journey,
          completedNodeIds: Array.from(
            new Set([...(existingDoc.modes.journey.completedNodeIds || []), ...(localJourney?.completedNodeIds || [])])
          ),
        },
        hashiraKatas: {
          ...existingDoc.modes.hashiraKatas,
          completedLessons: {
            ...existingDoc.modes.hashiraKatas.completedLessons,
            ...(localKata?.completedLessons || {}),
          },
        },
        cullingDojo: {
          completedLessonIds: Array.from(
            new Set([...(existingDoc.modes.cullingDojo.completedLessonIds || []), ...(localCullingIds || [])])
          ),
        },
      },
      inventory: {
        ...existingDoc.inventory,
        chests: localChests?.chests || existingDoc.inventory.chests,
      },
      updatedAt: Date.now(),
    };

    await setDoc(userDocRef, mergedDoc, { merge: true });
    console.log(`[PlayerSync] Migration of local storage to Firestore completed for user ${uid}.`);
  } catch (err) {
    console.warn("[PlayerSync] Error during local to cloud migration:", err);
  }
}
