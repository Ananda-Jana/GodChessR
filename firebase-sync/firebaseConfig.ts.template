  projectId: import.meta.env.VITE_FIREBASE_PROJECT_ID || "mugenchessx",
  storageBucket: import.meta.env.VITE_FIREBASE_STORAGE_BUCKET || "mugenchessx.appspot.com",
  messagingSenderId: import.meta.env.VITE_FIREBASE_MESSAGING_SENDER_ID || "YOUR_MESSAGING_SENDER_ID",
  appId: import.meta.env.VITE_FIREBASE_APP_ID || "YOUR_FIREBASE_APP_ID",
};

export const isFirebaseSyncEnabled = (): boolean => {
