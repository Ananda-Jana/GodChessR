/**
 * FIREBASE AUTHENTICATION BRIDGE COMPONENT TEMPLATE
 * 
 * Sits beside existing AuthContext without replacing it.
 * Supports Anonymous Sign-in, Email/Password, and Google Sign-in.
 * Triggers migrateLocalToCloud(uid) upon successful authentication.
 */

import React, { createContext, useContext, useEffect, useState } from "react";
import {
  User as FirebaseUser,
  signInAnonymously,
  signInWithEmailAndPassword,
  createUserWithEmailAndPassword,
  signOut,
  onAuthStateChanged,
  GoogleAuthProvider,
  signInWithPopup,
} from "firebase/auth";
import { auth } from "./firebaseClient";
import { migrateLocalToCloud } from "./playerSync";

interface AuthBridgeContextType {
  firebaseUser: FirebaseUser | null;
  isFirebaseLoading: boolean;
  signInGuest: () => Promise<void>;
  signInEmail: (email: string, pass: string) => Promise<void>;
  signUpEmail: (email: string, pass: string) => Promise<void>;
  signInGoogle: () => Promise<void>;
  logoutFirebase: () => Promise<void>;
}

const AuthBridgeContext = createContext<AuthBridgeContextType | undefined>(undefined);

export const FirebaseAuthProvider: React.FC<{ children: React.ReactNode }> = ({ children }) => {
  const [firebaseUser, setFirebaseUser] = useState<FirebaseUser | null>(null);
  const [isFirebaseLoading, setIsFirebaseLoading] = useState<boolean>(true);

  useEffect(() => {
    if (!auth) {
      setIsFirebaseLoading(false);
      return;
    }

    const unsubscribe = onAuthStateChanged(auth, async (user) => {
      setFirebaseUser(user);
      setIsFirebaseLoading(false);
      if (user) {
        console.log(`[FirebaseAuth] User signed in with UID: ${user.uid}`);
        await migrateLocalToCloud(user.uid);
      }
    });

    return () => unsubscribe();
  }, []);

  const signInGuest = async () => {
    if (!auth) return;
    try {
      await signInAnonymously(auth);
    } catch (err) {
      console.warn("[FirebaseAuth] Anonymous sign-in error:", err);
    }
  };

  const signInEmail = async (email: string, pass: string) => {
    if (!auth) return;
    await signInWithEmailAndPassword(auth, email, pass);
  };

  const signUpEmail = async (email: string, pass: string) => {
    if (!auth) return;
    await createUserWithEmailAndPassword(auth, email, pass);
  };

  const signInGoogle = async () => {
    if (!auth) return;
    const provider = new GoogleAuthProvider();
    await signInWithPopup(auth, provider);
  };

  const logoutFirebase = async () => {
    if (!auth) return;
    await signOut(auth);
  };

  return (
    <AuthBridgeContext.Provider
      value={{
        firebaseUser,
        isFirebaseLoading,
        signInGuest,
        signInEmail,
        signUpEmail,
        signInGoogle,
        logoutFirebase,
      }}
    >
      {children}
    </AuthBridgeContext.Provider>
  );
};

export const useFirebaseAuth = () => {
  const context = useContext(AuthBridgeContext);
  if (!context) {
    throw new Error("useFirebaseAuth must be used within a FirebaseAuthProvider");
  }
  return context;
};
